{
  "name": "@evilmartians/agent-prism",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "build": "pnpm --filter './packages/{types,data}' build && pnpm --filter './packages/{ui,demo-app,storybook,saas}' build",
    "deploy:storybook": "pnpm --filter @evilmartians/agent-prism-storybook build && firebase deploy --only hosting",
    "deploy:saas": "pnpm --filter saas build && firebase deploy --only hosting:ai-trace-explorer",
    "format": "pnpm exec prettier . --write",
    "format:check": "pnpm exec prettier . --check",
    "lint:check": "oxlint --deny-warnings --report-unused-disable-directives-severity=error --ignore-pattern '**/lint-fixtures' && node scripts/check-boundaries-fixture.mjs",
    "lint:fix": "oxlint --fix --ignore-pattern '**/lint-fixtures'",
    "lint:packages": "publint packages/types && publint packages/data && attw --pack packages/types --profile esm-only && attw --pack packages/data --profile esm-only",
    "knip": "knip",
    "jscpd": "jscpd -l 6 -k 40 -t 1.56 -i '**/*.test.ts,**/tests/**,**/test-utils/**,**/create-mock-*' packages/data/src packages/types/src && jscpd -l 10 -k 70 -t 0 packages/ui/src",
    "dup": "jscpd -l 2 -k 12 -m weak -t 100 -s -a -r json -o reports/jscpd packages/*/src && node scripts/jscpd-top.mjs",
    "tsc": "pnpm run --parallel tsc",
    "test": "pnpm run --parallel test",
    "theme:generate": "pnpm --filter @evilmartians/agent-prism-ui generate-theme-files",
    "dist:rm": "pnpm -r exec rm -rf dist out"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-filename-export": "^2.0.0",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.9.3",
    "eslint-plugin-sonarjs": "^3.0.7",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "jscpd": "^5.4.0",
    "knip": "^6.39.0",
    "oxlint": "^1.86.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "publint": "^0.3.25"
  }
}

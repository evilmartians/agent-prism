{
  "name": "@evilmartians/agent-prism-data",
  "private": false,
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evilmartians/agent-prism.git",
    "directory": "packages/data"
  },
  "type": "module",
  "main": "./dist/index.js",

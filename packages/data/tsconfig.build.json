{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {}
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/test-utils",
    "src/**/create-mock-*.ts"
  ]
}
